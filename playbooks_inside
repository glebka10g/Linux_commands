VARIABLES:

vars:
  my_package: htop  - описания variables
name: "{{ my_package }} - use variables
  

HANDLER:
  handlers:
    - name: restart nginx
      service:
        name: nginx
        state: restarted

notify: restart nginx - use handler

LOOP:
  vars:
    packages:
      - htop
      - curl
      - git

  tasks:
    - name: Install packages
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ packages }}"  --- LOOP
